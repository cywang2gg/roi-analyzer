#include <winuser.h>
1 RT_MANIFEST "app.manifest"

#define IDD_ROTATE_ANGLE 201
#define IDC_ROTATE_ANGLE 202
#define IDD_MONITOR_SETTINGS 210
#define IDC_MON_PATH1 211
#define IDC_MON_PATH2 212
#define IDC_MON_PATH3 213
#define IDC_MON_BROWSE1 214
#define IDC_MON_BROWSE2 215
#define IDC_MON_BROWSE3 216
#define IDC_MON_ACTIVE1 217
#define IDC_MON_ACTIVE2 218
#define IDC_MON_ACTIVE3 219
#define IDD_NEW_FILE_PROMPT 220
#define IDC_PROMPT_THUMB 221
#define IDC_PROMPT_NAME 222
#define IDC_PROMPT_BTN_RENAME 223
#define IDC_PROMPT_BTN_RENAME_OPEN 224
#define IDC_PROMPT_BTN_COMPARE_ADD 225
#define IDC_PROMPT_BTN_COMPARE_NOW 226
#define IDD_RENAME_INPUT 230
#define IDC_RENAME_EDIT 231
#define IDD_METRICS_PROGRESS 240
#define IDC_METRICS_PBAR 241
#define IDC_METRICS_STATUS 242

IDD_ROTATE_ANGLE DIALOGEX 0, 0, 184, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rotate Arbitrary"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Angle in degrees (-360 to 360):", -1, 7, 8, 170, 10
    EDITTEXT IDC_ROTATE_ANGLE, 7, 22, 92, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 105, 22, 32, 14
    PUSHBUTTON "Cancel", IDCANCEL, 142, 22, 36, 14
END

IDD_RENAME_INPUT DIALOGEX 0, 0, 280, 66
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Image"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "New file name (without extension):", -1, 7, 8, 260, 10
    EDITTEXT IDC_RENAME_EDIT, 7, 23, 266, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 190, 44, 38, 16
    PUSHBUTTON "Cancel", IDCANCEL, 235, 44, 38, 16
END

IDD_NEW_FILE_PROMPT DIALOGEX 0, 0, 350, 156
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "New Image Detected"
FONT 9, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_PROMPT_THUMB, "STATIC", SS_OWNERDRAW | WS_BORDER, 8, 8, 92, 96
    LTEXT "New file name (without extension):", -1, 108, 12, 230, 10
    EDITTEXT IDC_PROMPT_NAME, 108, 27, 232, 16, ES_AUTOHSCROLL
    LTEXT "Choose an action:", -1, 108, 52, 230, 10
    PUSHBUTTON "Rename", IDC_PROMPT_BTN_RENAME, 7, 116, 63, 25
    PUSHBUTTON "Rename && Open", IDC_PROMPT_BTN_RENAME_OPEN, 75, 116, 70, 25
    PUSHBUTTON "Add Compare", IDC_PROMPT_BTN_COMPARE_ADD, 150, 116, 65, 25
    PUSHBUTTON "Compare Now", IDC_PROMPT_BTN_COMPARE_NOW, 220, 116, 65, 25
    PUSHBUTTON "Cancel", IDCANCEL, 290, 116, 52, 25
END

IDD_MONITOR_SETTINGS DIALOGEX 0, 0, 330, 116
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Folder Monitor Settings"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "Folder", -1, 7, 7, 42, 10
    LTEXT "Active", -1, 284, 7, 36, 10
    EDITTEXT IDC_MON_PATH1, 7, 21, 247, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_MON_BROWSE1, 258, 21, 52, 14
    CONTROL "", IDC_MON_ACTIVE1, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 313, 22, 10, 12
    EDITTEXT IDC_MON_PATH2, 7, 42, 247, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_MON_BROWSE2, 258, 42, 52, 14
    CONTROL "", IDC_MON_ACTIVE2, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 313, 43, 10, 12
    EDITTEXT IDC_MON_PATH3, 7, 63, 247, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_MON_BROWSE3, 258, 63, 52, 14
    CONTROL "", IDC_MON_ACTIVE3, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 313, 64, 10, 12
    DEFPUSHBUTTON "Save", IDOK, 233, 91, 38, 16
    PUSHBUTTON "Cancel", IDCANCEL, 275, 91, 38, 16
END

IDD_METRICS_PROGRESS DIALOGEX 0, 0, 220, 58
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Metrics Report"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "Analyzing visible image regions...", IDC_METRICS_STATUS, 7, 8, 206, 12
    CONTROL "", IDC_METRICS_PBAR, "msctls_progress32", WS_CHILD | WS_VISIBLE, 7, 27, 206, 14
END
